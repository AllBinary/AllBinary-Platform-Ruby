    <properties>
        <!-- Ruby interpreter. The Cygwin ruby is used when there is no Windows Ruby install. -->
        <ruby.executable>G:/cygwin64/bin/ruby.exe</ruby.executable>
        <!-- Require each file after compiling. Loading runs the class bodies so it finds errors compiling does not. -->
        <ruby.load.check>true</ruby.load.check>
        <!-- Set to false to continue the Maven build when the generated Ruby does not compile or load -->
        <ruby.fail.on.error>true</ruby.fail.on.error>
        <ruby.dependency.directory>${project.build.directory}/ruby-dependencies/META-INF/ruby/lib</ruby.dependency.directory>
        <!-- Hand written runtime for generated Ruby code such as java/util/Vector -->
        <ruby.runtime.directory>G:/mnt/bc/mydev/workruby/j2me/J2SEForRubyLibraryRbM/src/main/java</ruby.runtime.directory>
    </properties>

