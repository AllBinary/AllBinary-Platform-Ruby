<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.allbinary.game.resources</groupId>
    <artifactId>GameSoundsOggResourcesJavaLibraryRb</artifactId>
    <packaging>jar</packaging>
    <!-- AllBinary Platform Version Start -->
    <version>1.0.0-SNAPSHOT</version>
    <!-- AllBinary Platform Version End -->

    <name>GameSoundsOggResourcesJavaLibraryRb</name>
    <url>http://www.allbinary.com</url>
  
    <distributionManagement>
        <snapshotRepository>
            <id>nexus-snapshots</id>
            <name>AllBinary Snapshots Nexus</name>
            <url>https://nexus-allbinary.rhcloud.com/nexus/content/repositories/snapshots/</url>
        </snapshotRepository>
        <repository>
            <id>nexus-releases</id>
            <name>AllBinary Releases Nexus</name>
            <url>https://nexus-allbinary.rhcloud.com/nexus/content/repositories/releases/</url>
        </repository>
    </distributionManagement>
      
    <properties>
        <buildLabel>${project.version}</buildLabel>
        <!-- Ruby interpreter. The Cygwin ruby is used when there is no Windows Ruby install. -->
        <ruby.executable>G:/cygwin64/bin/ruby.exe</ruby.executable>
        <!-- Require each file after compiling. Loading runs the class bodies so it finds errors compiling does not. -->
        <ruby.load.check>true</ruby.load.check>
        <!-- Set to false to continue the Maven build when the generated Ruby does not compile or load -->
        <ruby.fail.on.error>true</ruby.fail.on.error>
        <ruby.dependency.directory>${project.build.directory}/ruby-dependencies/META-INF/ruby/lib</ruby.dependency.directory>
        <!-- Hand written runtime for generated Ruby code such as java/util/Vector -->
        <ruby.runtime.directory>G:/mnt/bc/mydev/workruby/j2me/J2SEForRubyLibraryRbM/src/main/java</ruby.runtime.directory>
    </properties>

    <dependencies>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>unpack-ruby-dependencies</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>unpack-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <includeTypes>jar</includeTypes>
                            <excludeClassifiers>sources</excludeClassifiers>
                            <includes>META-INF/ruby/**</includes>
                            <outputDirectory>${project.build.directory}/ruby-dependencies</outputDirectory>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>compile-ruby-sources</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${ruby.executable}</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>${project.basedir}/build.rb</argument>
                                <argument>${project.basedir}/src/main/java</argument>
                                <argument>${project.build.outputDirectory}/META-INF/ruby/lib</argument>
                                <argument>${ruby.load.check}</argument>
                                <argument>${ruby.fail.on.error}</argument>
                                <argument>${ruby.dependency.directory}</argument>
                                <argument>${ruby.runtime.directory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>


        </plugins>
    </build>

</project>


