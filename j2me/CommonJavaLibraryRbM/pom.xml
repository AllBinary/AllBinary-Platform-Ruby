<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.allbinary</groupId>
    <artifactId>CommonJavaLibraryRb</artifactId>
    <packaging>jar</packaging>
    <!-- AllBinary Platform Version Start -->
    <version>1.0.0-SNAPSHOT</version>
    <!-- AllBinary Platform Version End -->

    <name>CommonJavaLibraryRb</name>
    <url>http://www.allbinary.com/</url>
    <distributionManagement>
        <snapshotRepository>
            <id>nexus-snapshots</id>
            <name>AllBinary Snapshots Nexus</name>
            <url>https://nexus-allbinary.rhcloud.com/nexus/content/repositories/snapshots/</url>
        </snapshotRepository>
        <repository>
            <id>nexus-releases</id>
            <name>AllBinary Releases Nexus</name>
            <url>https://nexus-allbinary.rhcloud.com/nexus/content/repositories/releases/</url>
        </repository>
    </distributionManagement>
    <properties>
        <!-- Ruby interpreter. The Cygwin ruby is used when there is no Windows Ruby install. -->
        <ruby.executable>G:/cygwin64/bin/ruby.exe</ruby.executable>
        <ruby.jsinterop.source.path>G:/mnt/bc/mydev/workingruby/replace_these_stub_projects/allbinary_src/J2MEJsInteropCompatibilityJavaLibraryRbM/src/main/java</ruby.jsinterop.source.path>
        <!-- Require each file after compiling. Loading runs the class bodies so it finds errors compiling does not. -->
        <ruby.load.check>true</ruby.load.check>
        <!-- Set to false to continue the Maven build when the generated Ruby does not compile or load -->
        <ruby.fail.on.error>true</ruby.fail.on.error>
        <!-- Hand written runtime for generated Ruby code such as java/lang/System -->
        <ruby.runtime.directory>G:/mnt/bc/mydev/workruby/j2me/J2SEForRubyLibraryRbM/src/main/java</ruby.runtime.directory>
    </properties>

    <dependencies>
        <!--
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>3.8.1</version>
            <scope>test</scope>
        </dependency>
        -->

        <!-- Enable when J2MEJsInteropCompatibilityJavaLibraryRbM has a pom
        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>J2MEJsInteropCompatibilityJavaLibraryRb</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        -->

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>compile-ruby-sources</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${ruby.executable}</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>${project.basedir}/build.rb</argument>
                                <argument>${project.basedir}/src/main/java</argument>
                                <argument>${project.build.outputDirectory}/META-INF/ruby/lib</argument>
                                <argument>${ruby.load.check}</argument>
                                <argument>${ruby.fail.on.error}</argument>
                                <argument>${ruby.jsinterop.source.path}</argument>
                                <argument>${ruby.runtime.directory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>


            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

    </build>

</project>
